# Copy to .env and fill in your own values. Never commit a real .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your own logged-in Swiggy session cookie (copy from your browser's DevTools
# on swiggy.com). Rotate it if it stops working.
SWIGGY_COOKIE=
# Dark-store ids from your swiggy.com/instamart tab (URL / page state).
# At least the primary store id is required.
SWIGGY_STORE_ID=
SWIGGY_PRIMARY_STORE_ID=
SWIGGY_SECONDARY_STORE_ID=
SWIGGY_DEVICE_ID=
SWIGGY_BUILD_VERSION=2.363.0
MIN_DISCOUNT=70
